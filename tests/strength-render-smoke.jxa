#!/usr/bin/env osascript -l JavaScript
// DASHBOARD_JS=js/dashboard.js osascript -l JavaScript tests/strength-render-smoke.jxa

ObjC.import('Foundation');

const sourcePath = ObjC.unwrap(
  $.NSProcessInfo.processInfo.environment.objectForKey('DASHBOARD_JS')
);
if (!sourcePath) throw new Error('Set DASHBOARD_JS before running this test.');

var elements = {
  'running-summary': { innerHTML: '' },
  'running-load': { getContext: function () { return {}; } },
  'running-distance': { getContext: function () { return {}; } },
  'running-long': { getContext: function () { return {}; } },
};
var document = {
  addEventListener: function () {},
  getElementById: function (id) { return elements[id] || null; },
};
var window = { location: { hash: '' }, addEventListener: function () {} };
var history = { replaceState: function () {} };
var getComputedStyle = function () {
  return { getPropertyValue: function () { return ''; } };
};
var Chart = function (context, config) {
  this.config = config;
  this.destroy = function () {};
};

var source = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(
  sourcePath,
  $.NSUTF8StringEncoding,
  null
));

[
  "strength ? 'Strength'",
  "workload ? 'Hours'",
  "label: 'Weekly Workouts'",
  '!doc.sports.strength',
].forEach(function (expected) {
  if (source.indexOf(expected) < 0) throw new Error('Missing Strength chart/load path: ' + expected);
});

source += `
activeSport = 'strength';
runningRange = {start: '2026-08-31', end: '2026-09-27'};
var originalRange = JSON.stringify(runningRange);
var workouts = [
  {date: '2026-08-31', duration_seconds: 1800, tss: 20},
  {date: '2026-09-07', duration_seconds: 3600, tss: 40},
  {date: '2026-09-14', duration_seconds: 1800, tss: 0},
  {date: '2026-09-21', duration_seconds: 7200, tss: 60}
];
var summary = sportSummary(workouts, 'strength');
if (summary.count !== 4 || summary.seconds !== 14400 || summary.tss !== 120) throw new Error('Strength totals failed');
if (Math.abs(summary.perWeek - 1) > 0.0001) throw new Error('Strength exact-day frequency failed');
if (summary.averageDuration !== 3600 || summary.averageTss !== 30) throw new Error('Strength averages failed');
if (fmtAverageDuration(2700) !== '45 min' || fmtAverageDuration(5400) !== '1:30 h') throw new Error('Strength duration formatting failed');
renderRunningSummary(workouts);
var html = elements['running-summary'].innerHTML;
if ((html.match(/running-metric"/g) || []).length !== 6) throw new Error('Six Strength metrics were not rendered');
['Workouts', 'Time', 'Workouts/week', 'TSS', 'Avg Duration', 'Avg TSS'].forEach(function (label) {
  if (html.indexOf(label) < 0) throw new Error('Missing Strength metric: ' + label);
});
if (html.indexOf('Distance') >= 0 || html.indexOf('Races') >= 0) throw new Error('Endurance-only metrics leaked into Strength');
var weeks = sportWeeks(workouts);
if (weeks.length !== 4 || weeks[0].time_hours !== 0.5 || weeks[3].time_hours !== 2
    || Math.abs(weeks[3].time_moving_average - 1) > 0.0001
    || weeks[3].workouts !== 1 || weeks[3].workouts_moving_average !== 1) {
  throw new Error('Strength weekly time/workout moving averages failed');
}
var loadChart = buildRunningLoadChart([{date: '2026-09-01', tss: 20, ctl: 10, atl: 12}]);
if (loadChart.config.data.datasets[0].label !== 'Strength TSS'
    || loadChart.config.data.datasets[1].label !== 'Strength CTL'
    || loadChart.config.data.datasets[2].label !== 'Strength ATL') {
  throw new Error('Strength load chart labels failed');
}
var timeChart = buildRunningDistanceChart(weeks);
if (timeChart.config.options.scales.y.title.text !== 'Hours'
    || timeChart.config.data.datasets[0].label !== 'Weekly Time'
    || timeChart.config.data.datasets[1].label !== '4-week average') {
  throw new Error('Strength weekly time chart failed');
}
var workoutChart = buildRunningLongChart(weeks);
if (workoutChart.config.options.scales.y.title.text !== 'Workouts'
    || workoutChart.config.data.datasets[0].label !== 'Weekly Workouts'
    || workoutChart.config.data.datasets[1].label !== '4-week average') {
  throw new Error('Strength weekly workout chart failed');
}
activeSport = 'running';
activeSport = 'cycling';
activeSport = 'swimming';
activeSport = 'strength';
activeSport = 'running';
if (JSON.stringify(runningRange) !== originalRange) throw new Error('Date range changed while switching sports');
activeSport = 'strength';
var empty = sportSummary([], 'strength');
if (empty.count !== 0 || empty.seconds !== 0 || empty.tss !== 0
    || empty.averageDuration !== null || empty.averageTss !== null) {
  throw new Error('Empty Strength range was not graceful');
}
console.log('Strength render smoke tests passed');
`;

eval(source);
